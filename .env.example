# Gemini API key (https://aistudio.google.com/apikey) — server-side only, never expose to the client.
# Used for the two agents that need real audio understanding (pronunciation
# grading, spoken Q&A), plus translation grading and sentence generation.
GEMINI_API_KEY=

# Mistral API key (https://console.mistral.ai) — server-side only, never expose to the client.
# Used for the remaining text-only agents (bank building, text Q&A), and as the
# automatic fallback for translation grading if the Gemini call fails.
MISTRAL_API_KEY=

# Postgres connection string (Vercel Postgres / Neon). Provided automatically when the
# Vercel Postgres integration is added to the project; for local dev, use your own
# Neon connection string here.
DATABASE_URL=
